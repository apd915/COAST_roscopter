# Per-replan planner timing breakdown.
#
# Field names intentionally mirror SANDO's dynus_interfaces/ComputationTimes so the
# two planners can be benchmarked apples-to-apples. See the mapping notes below --
# not every stage exists in both planners, so compare stage-by-stage, not just totals.
#
#   ours                      <-> SANDO
#   front_end_ms              <-> global_planning_ms + cvx_decomp_ms
#   back_end_ms               <-> local_traj_ms
#   comparable_total_ms       <-> global_planning_ms + cvx_decomp_ms + local_traj_ms
#
# SANDO's total_replanning_ms additionally covers safe_paths / safety_check /
# yaw_sequence / yaw_fitting stages that this planner does not implement, so
# total_replanning_ms here is NOT directly comparable to theirs -- use
# comparable_total_ms for that.

std_msgs/Header header

# Did this replan produce a usable trajectory?
bool result

# Did the front-end path actually reach the commanded goal (vs a truncated /
# time-limited partial path)?
bool reached_goal

# --- Totals ---
# Wall time of the whole plan_mission() call.
float64 total_replanning_ms
# front_end_ms + matrix_build_ms + back_end_ms. Use this one against SANDO.
float64 comparable_total_ms

# --- Stage breakdown ---
# A* search + line-of-sight smoothing + SFC corridor construction.
float64 front_end_ms
# Constraint matrix assembly (summed over all solve attempts).
float64 matrix_build_ms
# OSQP solve time, summed over ALL attempts (see solve_attempts).
float64 back_end_ms
# Whatever is left of the total after the stages above.
float64 overhead_ms

# --- Running statistics since node start ---
# A 10 Hz loop is broken by the tail, not the average, so the max matters more than the mean.
# Published alongside each sample so the distribution is visible live without post-processing
# a bag.
uint32 replan_count
float64 min_total_ms
float64 max_total_ms
float64 mean_total_ms

# --- Problem size / solver effort ---
# Number of time-stretch attempts made this cycle. >1 means the first solve(s)
# failed and the trajectory was re-sized; back_end_ms covers all of them.
uint16 solve_attempts
# SFC corridors generated by the front-end.
uint16 num_corridors
# B-spline control points in the final trajectory.
uint16 num_control_points

# Which waypoint leg this replan belongs to (1-based). Published so external tools can align
# their own measurements to the same leg boundaries the planner reports -- without it, anything
# analysing tracking has to guess where one leg ends and the next begins.
uint16 leg
